<?xml version="1.0" encoding="utf-8"?>
<!--
    Card type scale, from the design spec (section 3). Letter spacing in the spec is in sp;
    Android takes it in em, so each value is divided by the text size.
-->
<resources>
    <style name="AagText">
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>

    <!-- type-hero-num: 40sp medium, line 42sp, -0.5sp (the spec's 36sp, scaled for the 104dp card) -->
    <style name="AagText.Hero">
        <item name="android:textSize">40sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineHeight">42sp</item>
        <item name="android:letterSpacing">-0.0125</item>
        <item name="android:ellipsize">none</item>
    </style>

    <!-- type-hero-compact: 28sp medium, line 30sp, -0.3sp -->
    <style name="AagText.HeroCompact">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineHeight">30sp</item>
        <item name="android:letterSpacing">-0.0107</item>
        <item name="android:ellipsize">none</item>
    </style>

    <!-- type-title: 18.5sp medium, line 23sp (the spec's 17sp, scaled for the 104dp card) -->
    <style name="AagText.Title">
        <item name="android:textSize">18.5sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineHeight">23sp</item>
    </style>

    <!-- type-badge: 16sp medium (bold where the spec says so), line 19sp (the spec's 15sp, scaled) -->
    <style name="AagText.Badge">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineHeight">19sp</item>
        <item name="android:ellipsize">none</item>
    </style>

    <!-- type-detail: 13.5sp regular, line 18sp, +0.1sp (the spec's 13sp, scaled) -->
    <style name="AagText.Detail">
        <item name="android:textSize">13.5sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineHeight">18sp</item>
        <item name="android:letterSpacing">0.0077</item>
        <item name="android:textColor">#FFD8E2F0</item>
    </style>

    <!-- type-label: 12.5sp medium, line 16sp, +0.2sp (the spec's 12sp, scaled) -->
    <style name="AagText.Label">
        <item name="android:textSize">12.5sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineHeight">16sp</item>
        <item name="android:letterSpacing">0.0167</item>
        <item name="android:textColor">#FF93C5FD</item>
    </style>

    <!-- type-chip: 12.5sp medium, line 15sp, +0.1sp, at most 6 characters -->
    <style name="AagText.Chip">
        <item name="android:textSize">12.5sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <!-- No extra font padding, so the text sits on the pill's true centre. -->
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineHeight">15sp</item>
        <item name="android:letterSpacing">0.008</item>
        <item name="android:maxWidth">44dp</item>
        <item name="android:ellipsize">none</item>
    </style>

    <!-- Every card: the slot holding the card body, both @dimen/card_body_height. -->
    <style name="AagCardRoot">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/card_body_height</item>
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <style name="AagCardBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/card_body_height</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>
</resources>
