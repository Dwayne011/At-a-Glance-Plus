<?xml version="1.0" encoding="utf-8"?>
<!-- 8.7 trip progress, 3dp; the filled colour is set per route section in code. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle"><corners android:radius="1.5dp" /><solid android:color="#29FFFFFF" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle"><corners android:radius="1.5dp" /><solid android:color="#FF6EE7B7" /></shape>
        </clip>
    </item>
</layer-list>
