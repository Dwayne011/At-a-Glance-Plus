<?xml version="1.0" encoding="utf-8"?>
<!-- 6.1 message avatar, entering: the disc pops in, a ring bursts out once, then the halo pulses. White, tinted to the app's colour by the card. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="72dp"
            android:height="72dp"
            android:viewportWidth="72"
            android:viewportHeight="72">
            <group android:name="halo" android:pivotX="36" android:pivotY="36">
                <path android:name="halo_fill" android:fillColor="#FFFFFFFF" android:fillAlpha="0" android:pathData="M15,36 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0" />
            </group>
            <group android:name="ring" android:pivotX="36" android:pivotY="36">
                <path android:name="ring_line" android:fillColor="#00000000" android:strokeColor="#FFFFFFFF" android:strokeAlpha="0" android:strokeWidth="2" android:pathData="M15,36 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0" />
            </group>
            <group android:name="disc" android:pivotX="36" android:pivotY="36">
                <path android:fillColor="#FFFFFFFF" android:pathData="M15,36 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="halo">
        <aapt:attr name="android:animation">
            <set>
            <objectAnimator
                android:duration="2000"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="scaleX"
                android:startOffset="700"
                android:repeatCount="infinite"
                android:repeatMode="restart"
                android:valueFrom="1"
                android:valueTo="1.6"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="2000"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="scaleY"
                android:startOffset="700"
                android:repeatCount="infinite"
                android:repeatMode="restart"
                android:valueFrom="1"
                android:valueTo="1.6"
                android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="halo_fill">
        <aapt:attr name="android:animation">
            <set>
            <objectAnimator
                android:duration="2000"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="fillAlpha"
                android:startOffset="700"
                android:repeatCount="infinite"
                android:repeatMode="restart"
                android:valueFrom="0.35"
                android:valueTo="0"
                android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="disc">
        <aapt:attr name="android:animation">
            <set>
            <objectAnimator
                android:duration="420"
                android:interpolator="@android:anim/overshoot_interpolator"
                android:propertyName="scaleX"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="420"
                android:interpolator="@android:anim/overshoot_interpolator"
                android:propertyName="scaleY"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="ring">
        <aapt:attr name="android:animation">
            <set>
            <objectAnimator
                android:duration="650"
                android:interpolator="@android:anim/decelerate_interpolator"
                android:propertyName="scaleX"
                android:startOffset="120"
                android:valueFrom="1"
                android:valueTo="1.6"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="650"
                android:interpolator="@android:anim/decelerate_interpolator"
                android:propertyName="scaleY"
                android:startOffset="120"
                android:valueFrom="1"
                android:valueTo="1.6"
                android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="ring_line">
        <aapt:attr name="android:animation">
            <set>
            <objectAnimator
                android:duration="650"
                android:interpolator="@android:anim/decelerate_interpolator"
                android:propertyName="strokeAlpha"
                android:startOffset="120"
                android:valueFrom="0.9"
                android:valueTo="0"
                android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
