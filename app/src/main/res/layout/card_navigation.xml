<?xml version="1.0" encoding="utf-8"?>
<!--
    8.7 Navigating to a place: manoeuvre box (with a travel-mode badge), distance and instruction,
    destination line, trip progress bar, right-column chips.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    style="@style/AagCardRoot">

    <LinearLayout
        android:id="@+id/card_body"
        style="@style/AagCardBody"
        android:background="@drawable/card_bg_nav"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/nav_box"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/nav_box_bg">

            <ImageView
                android:id="@+id/nav_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_turn_left" />

            <!-- Travel mode (train, bus, walk, bike), when the directions say. -->
            <ImageView
                android:id="@+id/nav_mode"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/nav_mode_bg"
                android:contentDescription="@null"
                android:padding="2dp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/nav_distance"
                    style="@style/AagText.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="#FF6EE7B7"
                    android:textStyle="bold" />

                <!-- No start margin: when there is no distance, the line starts flush with the one below. -->
                <TextView
                    android:id="@+id/nav_instruction"
                    style="@style/AagText.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/nav_detail"
                style="@style/AagText.Detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFA7F3D0" />

            <!-- The trip bar, drawn in code: each leg in its colour, a ring at each change, a dot
                 where you are and a flag at the end. Kept to its shape (fitStart), never stretched. -->
            <ImageView
                android:id="@+id/nav_trip"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="6dp"
                android:contentDescription="@null"
                android:scaleType="fitStart"
                android:visibility="gone" />

            <!-- Under it: distance and time left, and the arrival time, when the maps app says. -->
            <LinearLayout
                android:id="@+id/nav_trip_labels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/nav_trip_left"
                    style="@style/AagText.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#FFA7F3D0"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/nav_trip_arrival"
                    style="@style/AagText.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:singleLine="true"
                    android:textColor="#FFE2E8F0"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/complications"
            android:layout_width="84dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Hold ring (spec 6.3): traces the card's edge while it is held, until the launcher's menu opens. -->
    <ImageView
        android:id="@+id/hold_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_body_height"
        android:layout_gravity="center_vertical"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:scaleType="fitXY"
        android:src="@drawable/hold_bar_red_400" />
</FrameLayout>
