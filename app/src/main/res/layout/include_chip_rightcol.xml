<?xml version="1.0" encoding="utf-8"?>
<!--
    Material You weather card (weather spec 1.4): a 26dp tonal pill the column's full 78dp wide, in a
    78 x 38dp tap zone, so two stacked pills are the same width and sit 12dp apart, as on the
    other cards' right column. Added into a card with
    RemoteViews.addView, so ids are local to each chip.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chip_zone"
    android:layout_width="78dp"
    android:layout_height="38dp">

    <LinearLayout
        android:id="@+id/chip_pill"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_gravity="center_vertical"
        android:duplicateParentState="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/chip_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/chip_text"
            style="@style/AagText.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:maxWidth="42dp"
            android:textSize="12.5sp" />
    </LinearLayout>
</FrameLayout>
