<?xml version="1.0" encoding="utf-8"?>
<!--
    Material You weather card (weather spec 1.4): a 26dp tonal pill (68 to 74dp wide) in the right
    column, in a 78 x 32dp tap zone, so two stacked pills sit 6dp apart. Added into a card with
    RemoteViews.addView, so ids are local to each chip.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chip_zone"
    android:layout_width="78dp"
    android:layout_height="32dp">

    <LinearLayout
        android:id="@+id/chip_pill"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_gravity="end|center_vertical"
        android:duplicateParentState="true"
        android:gravity="center"
        android:minWidth="68dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/chip_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/chip_text"
            style="@style/AagText.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:maxWidth="50dp" />
    </LinearLayout>
</FrameLayout>
