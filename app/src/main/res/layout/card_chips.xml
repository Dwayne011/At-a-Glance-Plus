<?xml version="1.0" encoding="utf-8"?>
<!--
    The extra card, two panels like the weather card: the chips that did not fit there (beside the
    next hours when there are only one or two), or, when there are none, today in words and the
    next days.
    Generated by tools/gen_weather_layouts.py.
-->
<!-- Weights in both directions are the only way to share the panels' room in a home-screen layout. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_root"
    style="@style/AagCardRoot"
    tools:ignore="NestedWeights,UseCompoundDrawables">

    <FrameLayout
        android:id="@+id/weather_scene"
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_body_height"
        android:layout_gravity="center_vertical"
        android:background="@drawable/card_scene_shape"
        android:clipToOutline="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/scene_sky"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/scene_a"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/scene_b"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/scene_c"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/scene_anim_sun"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_scene_sun"
            android:indeterminateOnly="true"
            android:maxHeight="400dp"
            android:maxWidth="2000dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/scene_anim_stars"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_scene_stars"
            android:indeterminateOnly="true"
            android:maxHeight="400dp"
            android:maxWidth="2000dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/scene_anim_wisps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_scene_wisps"
            android:indeterminateOnly="true"
            android:maxHeight="400dp"
            android:maxWidth="2000dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/scene_anim_clouds_light"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_scene_clouds_light"
            android:indeterminateOnly="true"
            android:maxHeight="400dp"
            android:maxWidth="2000dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/scene_anim_clouds_light_night"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_scene_clouds_light_night"
            android:indeterminateOnly="true"
            android:maxHeight="400dp"
            android:maxWidth="2000dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/scene_anim_clouds_heavy"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_scene_clouds_heavy"
            android:indeterminateOnly="true"
            android:maxHeight="400dp"
            android:maxWidth="2000dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/scene_anim_clouds_heavy_night"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_scene_clouds_heavy_night"
            android:indeterminateOnly="true"
            android:maxHeight="400dp"
            android:maxWidth="2000dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/scene_anim_fog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_scene_fog"
            android:indeterminateOnly="true"
            android:maxHeight="400dp"
            android:maxWidth="2000dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/scene_anim_rain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_scene_rain"
            android:indeterminateOnly="true"
            android:maxHeight="400dp"
            android:maxWidth="2000dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/scene_anim_snow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_scene_snow"
            android:indeterminateOnly="true"
            android:maxHeight="400dp"
            android:maxWidth="2000dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/scene_anim_bolt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_scene_bolt"
            android:indeterminateOnly="true"
            android:maxHeight="400dp"
            android:maxWidth="2000dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/card_body"
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_body_height"
        android:layout_gravity="center_vertical"
        android:background="@drawable/weather_c_frame"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="6dp">

        <!-- Left: today in words (no chips), the next hours (a few chips), or gone (a full card of chips). -->
        <LinearLayout
            android:id="@+id/extra_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="34"
            android:background="@drawable/weather_c_panel_main"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/extra_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/extra_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:textColor="#FFFFFFFF"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/extra_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/extra_hours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:visibility="gone" />
        </LinearLayout>


        <!-- Right: the next days (no chips), or the chips in rows of tiles. -->
        <LinearLayout
            android:id="@+id/extra_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="66"
            android:background="@drawable/weather_c_panel_chips"
            android:orientation="vertical"
            android:padding="6dp">

            <LinearLayout
                android:id="@+id/chips_row1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/chips_row2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:layout_weight="1"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/extra_days"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone" />

            <!-- The days as rows: today first (highlighted), then the next three. -->
            <LinearLayout
                android:id="@+id/extra_rows"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

    <!-- Hold ring (spec 6.3): traces the card's edge while it is held, until the launcher's menu opens. -->
    <ImageView
        android:id="@+id/hold_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_body_height"
        android:layout_gravity="center_vertical"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:scaleType="fitXY"
        android:src="@drawable/hold_bar_amber_400" />
</FrameLayout>
