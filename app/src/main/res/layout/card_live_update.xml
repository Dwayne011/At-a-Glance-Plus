<?xml version="1.0" encoding="utf-8"?>
<!--
    8.2 Live Update: a delivery, ride, parcel or flight in progress from any app.
    40dp app badge, three lines (title, detail, up to 4 progress segments), ETA pill, dismiss.
    Segments are ImageViews with filled/unfilled backgrounds (a bare View is not allowed in RemoteViews).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    style="@style/AagCardRoot">

    <LinearLayout
        android:id="@+id/card_body"
        style="@style/AagCardBody"
        android:background="@drawable/card_bg_live"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/live_badge"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/live_badge_bg">

            <ImageView
                android:id="@+id/live_app_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:visibility="gone" />

            <TextView
                android:id="@+id/live_app_initial"
                style="@style/AagText.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#FF2DD4BF"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/live_title"
                style="@style/AagText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/live_detail"
                style="@style/AagText.Detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFB2F5EA" />

            <LinearLayout
                android:id="@+id/live_segments"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/live_seg_1"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/segment_off"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/live_seg_2"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/segment_off"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/live_seg_3"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/segment_off"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/live_seg_4"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/segment_off"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/live_eta"
            style="@style/AagText.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/live_eta_bg"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textColor="#FF5EEAD4"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/dismiss"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="-6dp"
            android:contentDescription="Dismiss">

            <ImageView
                android:id="@+id/dismiss_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@drawable/dismiss_bg"
                android:contentDescription="@null"
                android:padding="6dp"
                android:src="@drawable/ic_dismiss"
                android:tint="#FF94A3B8" />
        </FrameLayout>
    </LinearLayout>

    <!-- Hold ring (spec 6.3): traces the card's edge while it is held, until the launcher's menu opens. -->
    <ImageView
        android:id="@+id/hold_bar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:scaleType="fitXY"
        android:src="@drawable/hold_bar_red_400" />
</FrameLayout>
