<?xml version="1.0" encoding="utf-8"?>
<!-- One hour of forecast in a panel: the time, the weather and the temperature. Generated by tools/gen_weather_layouts.py. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
                android:id="@+id/hour_label"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#CCFFFFFF" />

    <ImageView
        android:id="@+id/hour_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:contentDescription="@null" />

    <TextView
                android:id="@+id/hour_value"
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFFFF" />
</LinearLayout>
