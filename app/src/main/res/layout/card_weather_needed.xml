<?xml version="1.0" encoding="utf-8"?>
<!-- 8.1 Weather, empty state: location needed. 42dp amber badge, tap opens setup. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    style="@style/AagCardRoot">

    <LinearLayout
        android:id="@+id/card_body"
        style="@style/AagCardBody"
        android:background="@drawable/card_bg_weather_needed"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/needed_badge"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/weather_needed_badge">

            <ImageView
                android:id="@+id/needed_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_weather_location_off" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/needed_title"
                style="@style/AagText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Weather: location needed" />

            <TextView
                android:id="@+id/needed_detail"
                style="@style/AagText.Detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap to enable location access"
                android:textColor="#FFCBD5E1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hold bar (spec 6.3): fills while the card is held, until the launcher's menu opens. -->
    <ImageView
        android:id="@+id/hold_bar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:layout_marginStart="22dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="22dp"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:scaleType="fitXY"
        android:src="@drawable/hold_bar_red_400" />
</FrameLayout>
