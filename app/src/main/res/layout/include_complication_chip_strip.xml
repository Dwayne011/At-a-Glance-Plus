<?xml version="1.0" encoding="utf-8"?>
<!--
    Complication chip for the bottom strip (spec 7.1 Layout B): the tap zone is as wide as the pill
    (64 to 84dp) and 34dp tall, reaching to the card's bottom edge; the 26dp tonal pill (chips spec
    2.1) sits 5dp above it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chip_zone"
    android:layout_width="wrap_content"
    android:layout_height="34dp"
    android:layout_marginEnd="6dp">

    <LinearLayout
        android:id="@+id/chip_pill"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="5dp"
                android:duplicateParentState="true"
        android:gravity="center"
        android:minWidth="64dp"
        android:orientation="horizontal"
        android:paddingStart="9dp"
        android:paddingEnd="9dp">

        <ImageView
            android:id="@+id/chip_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/chip_text"
            style="@style/AagText.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp" />
    </LinearLayout>
</FrameLayout>
