<?xml version="1.0" encoding="utf-8"?>
<!-- 8.4 Next calendar event, Layout A or no complications. Long text ends in "…". -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    style="@style/AagCardRoot">

    <LinearLayout
        android:id="@+id/card_body"
        style="@style/AagCardBody"
        android:background="@drawable/card_bg_calendar"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/calendar_bar"
            android:layout_width="5dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:src="@drawable/calendar_bar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/calendar_title"
                style="@style/AagText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/calendar_detail"
                style="@style/AagText.Detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFCBD5E1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/complications"
            android:layout_width="84dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Hold ring (spec 6.3): traces the card's edge while it is held, until the launcher's menu opens. -->
    <ImageView
        android:id="@+id/hold_bar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:scaleType="fitXY"
        android:src="@drawable/hold_bar_red_400" />
</FrameLayout>
