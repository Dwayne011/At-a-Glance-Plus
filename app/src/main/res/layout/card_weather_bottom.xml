<?xml version="1.0" encoding="utf-8"?>
<!--
    8.1 Weather, Layout B: a 40dp top row and a 36dp complication strip (up to 4 chips).
    Compact 28sp temperature and two text lines, per spec 8.1.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    style="@style/AagCardRoot">

    <LinearLayout
        android:id="@+id/card_body"
        style="@style/AagCardBody"
        android:background="@drawable/card_bg_weather_cloudy"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/weather_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_weather_cloudy" />

            <TextView
                android:id="@+id/weather_temp"
                style="@style/AagText.HeroCompact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/weather_title"
                    style="@style/AagText.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineHeight="18sp"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/weather_detail"
                    style="@style/AagText.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="#FFCBD5E1" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/complications"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="bottom|start"
            android:orientation="horizontal" />
    </LinearLayout>
</FrameLayout>
