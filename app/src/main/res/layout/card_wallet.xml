<?xml version="1.0" encoding="utf-8"?>
<!--
    8.6 Wallet pass near a place. The code box is pure white with a quiet zone so scanners
    can read it; it is hidden on the always-on display. No complications on this card.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    style="@style/AagCardRoot">

    <LinearLayout
        android:id="@+id/card_body"
        style="@style/AagCardBody"
        android:background="@drawable/card_bg_wallet"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/wallet_badge"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/wallet_badge_bg">

            <TextView
                android:id="@+id/wallet_initial"
                style="@style/AagText.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/wallet_title"
                style="@style/AagText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/wallet_detail"
                style="@style/AagText.Detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFBFDBFE" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wallet_barcode_box"
            android:layout_width="126dp"
            android:layout_height="54dp"
            android:background="@drawable/wallet_code_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/wallet_barcode"
                android:layout_width="106dp"
                android:layout_height="32dp"
                android:contentDescription="Barcode"
                android:scaleType="fitXY"
                android:src="@drawable/wallet_sample_barcode" />

            <TextView
                android:id="@+id/wallet_barcode_digits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="#FF000000"
                android:textSize="8.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/wallet_qr_box"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/wallet_code_bg"
            android:padding="5dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/wallet_qr"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:contentDescription="QR code"
                android:src="@drawable/wallet_sample_qr" />
        </FrameLayout>

        <TextView
            android:id="@+id/wallet_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/wallet_open_bg"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:singleLine="true"
            android:text="Open Wallet"
            android:textColor="#FF93C5FD"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Hold ring (spec 6.3): traces the card's edge while it is held, until the launcher's menu opens. -->
    <ImageView
        android:id="@+id/hold_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_body_height"
        android:layout_gravity="center_vertical"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:scaleType="fitXY"
        android:src="@drawable/hold_bar_red_400" />
</FrameLayout>
