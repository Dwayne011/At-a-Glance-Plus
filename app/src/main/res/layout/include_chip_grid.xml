<?xml version="1.0" encoding="utf-8"?>
<!--
    Weather hybrid spec, variant 3: one cell of the 2 x 2 grid (48 x 27dp tap zone, 24dp pill).
    Added into a card with RemoteViews.addView, so ids are local to each chip.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chip_zone"
    android:layout_width="48dp"
    android:layout_height="27dp">

    <LinearLayout
        android:id="@+id/chip_pill"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:duplicateParentState="true"
        android:gravity="center"
        android:minWidth="45dp"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingEnd="5dp">

        <ImageView
            android:id="@+id/chip_icon"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/chip_text"
            style="@style/AagText.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:maxWidth="56dp"
            android:textColor="#FFE2E2E6"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
