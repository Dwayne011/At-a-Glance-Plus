<?xml version="1.0" encoding="utf-8"?>
<!--
    Sports: a followed team's game (Material You sports spec 3.1 and 3.2). Home team on the left,
    away on the right, each in its own colours; scores beside them while live and after; the
    league, clock or start time and a status pill (LIVE, Next game, a countdown, or the result) in
    the middle. The surface is the arena slate washed with the home team's colour from the left
    and the away team's from the right, with a wave while live. Scores are hidden before a game,
    or when the user hides this team's scores.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    style="@style/AagCardRoot">

    <FrameLayout
        android:id="@+id/sports_surface"
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_body_height"
        android:layout_gravity="center_vertical"
        android:background="@drawable/sports_surface"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/sports_wash_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/sports_wash_home" />

        <ImageView
            android:id="@+id/sports_wash_away"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/sports_wash_away" />

        <ImageView
            android:id="@+id/sports_wave"
            android:layout_width="117dp"
            android:layout_height="78dp"
            android:layout_gravity="bottom|end"
            android:contentDescription="@null"
            android:src="@drawable/sports_wave"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/card_body"
        style="@style/AagCardBody"
        android:background="@drawable/sports_border"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="16dp">

        <!-- Home team: logo in its colour's circle, short name, HOME tag. -->
        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">

                <ImageView
                    android:id="@+id/sports_home_circle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/team_circle" />

                <ImageView
                    android:id="@+id/sports_home_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/team_ring" />

                <ImageView
                    android:id="@+id/sports_home_logo"
                    android:layout_width="29dp"
                    android:layout_height="29dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:id="@+id/sports_home_abbr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:singleLine="true"
                android:textColor="#FFE2E2E6"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sports_home_side"
                android:layout_width="45dp"
                android:layout_height="15dp"
                android:layout_marginTop="1dp"
                android:background="@drawable/tag_home_live"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingTop="2dp"
                android:singleLine="true"
                android:text="HOME"
                android:textColor="#FF410002"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/sports_home_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sports_league"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:singleLine="true"
                android:textAllCaps="true"
                android:textColor="#FF94A3B8"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/sports_status"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="2dp"
                android:autoSizeMaxTextSize="19sp"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/sports_pill"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/status_pill_live"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/sports_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null"
                    android:src="@drawable/live_dot" />

                <TextView
                    android:id="@+id/sports_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.06"
                    android:singleLine="true"
                    android:textColor="#FFFF8A80"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/sports_away_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />

        <!-- Away team: logo in its colour's circle, short name, AWAY tag. -->
        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">

                <ImageView
                    android:id="@+id/sports_away_circle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/team_circle" />

                <ImageView
                    android:id="@+id/sports_away_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:src="@drawable/team_ring" />

                <ImageView
                    android:id="@+id/sports_away_logo"
                    android:layout_width="29dp"
                    android:layout_height="29dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:id="@+id/sports_away_abbr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:singleLine="true"
                android:textColor="#FFE2E2E6"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sports_away_side"
                android:layout_width="45dp"
                android:layout_height="15dp"
                android:layout_marginTop="1dp"
                android:background="@drawable/tag_away_live"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingTop="2dp"
                android:singleLine="true"
                android:text="AWAY"
                android:textColor="#FF1B1C1E"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hold ring (spec 6.3): traces the card's edge while it is held, until the launcher's menu opens. -->
    <ImageView
        android:id="@+id/hold_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_body_height"
        android:layout_gravity="center_vertical"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:scaleType="fitXY"
        android:src="@drawable/hold_bar_red_400" />
</FrameLayout>
