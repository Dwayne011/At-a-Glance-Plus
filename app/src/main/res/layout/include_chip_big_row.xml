<?xml version="1.0" encoding="utf-8"?>
<!--
    A chip taking 2 slots in the weather card's row under the temperature: the same as
    include_chip_big, but it takes what the row has left after the other chips (layout_weight), so
    the pills beside it keep their full width whatever the card's real width; its own text ends in
    "…" if it must. Added into a card with RemoteViews.addView, so ids are local to each chip.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chip_zone"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1">

    <LinearLayout
        android:id="@+id/chip_pill"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_gravity="center"
                android:duplicateParentState="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:id="@+id/chip_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/chip_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/chip_text"
                style="@style/AagText.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:maxWidth="400dp"
                android:singleLine="true"
                android:textColor="#FFE2E2E6"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Tall: the second line. -->
        <TextView
            android:id="@+id/chip_detail"
            style="@style/AagText.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center"
            android:lineHeight="12sp"
            android:ellipsize="end"
            android:maxWidth="400dp"
            android:singleLine="true"
            android:textColor="#B3E2E2E6"
            android:textSize="10.5sp"
            android:visibility="gone" />

        <!-- Stacked: a third line (the countdown's date, eToro's value). -->
        <TextView
            android:id="@+id/chip_detail2"
            style="@style/AagText.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineHeight="14sp"
            android:ellipsize="end"
            android:maxWidth="400dp"
            android:singleLine="true"
            android:textSize="10sp"
            android:visibility="gone" />

        <!-- Stacked Bluetooth chip: the level, or the second device. -->
        <LinearLayout
            android:id="@+id/chip_row2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone" />

        <!-- How far along (steps toward the goal): a 2dp line across the pill, inside its padding. -->
        <ProgressBar
            android:id="@+id/chip_progress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="3dp"
            android:max="1000"
            android:minHeight="2dp"
            android:maxHeight="2dp"
            android:progressDrawable="@drawable/chip_progress"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
