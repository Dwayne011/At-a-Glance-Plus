<?xml version="1.0" encoding="utf-8"?>
<!--
    Test card rendered inside the native At a Glance slot through RemoteViews.
    Only RemoteViews-compatible views are allowed here (FrameLayout, LinearLayout, TextView,
    ImageView, ProgressBar, ...). No custom views, no RecyclerView, no ConstraintLayout.
    The launcher sizes the card to fit its slot; a 4x1 widget shape works best.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/card_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/card_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/card_icon_bg"
            android:contentDescription="@string/card_icon_description"
            android:padding="10dp"
            android:src="@drawable/ic_card"
            android:tint="#FF063B36" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/card_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/card_test_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/card_eta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/card_test_eta"
                    android:textColor="#FFB9F5EE"
                    android:textSize="15sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/card_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="55"
                android:progressDrawable="@drawable/card_progress" />

            <TextView
                android:id="@+id/card_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/card_test_layout_subtitle"
                android:textColor="#FFC9D6D8"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
