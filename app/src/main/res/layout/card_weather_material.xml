<?xml version="1.0" encoding="utf-8"?>
<!--
    8.1 Weather, Material You layout (weather spec 1, Option 1 + A+C1 adaptive overflow), the default.
    Zone 1: icon, temperature, date (or condition) and high/low/feels, with 1 or 2 chips under them.
    Zone 2: the next 3 hours, or 4 when the right column is hidden. Zone 3: up to 2 stacked chips,
    or one stacked over both slots, shown only when the chips do not all fit under the temperature.
    The surface (gradient and wave, or a scene) is drawn in weather_scene, behind the content.
    Padding 16dp left, 14dp right, 5dp top and bottom: a 72dp main row, then a 16dp summary line
    4dp under it (or the row alone, centred). Generated by tools/gen_weather_layouts.py.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    style="@style/AagCardRoot">

    <FrameLayout
        android:id="@+id/weather_scene"
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_body_height"
        android:layout_gravity="center_vertical"
        android:background="@drawable/card_scene_shape"
        android:clipToOutline="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/scene_sky"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/scene_a"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/scene_b"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/scene_c"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/scene_anim_sun"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_scene_sun"
            android:indeterminateOnly="true"
            android:maxHeight="400dp"
            android:maxWidth="2000dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/scene_anim_stars"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_scene_stars"
            android:indeterminateOnly="true"
            android:maxHeight="400dp"
            android:maxWidth="2000dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/scene_anim_clouds_light"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_scene_clouds_light"
            android:indeterminateOnly="true"
            android:maxHeight="400dp"
            android:maxWidth="2000dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/scene_anim_clouds_light_night"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_scene_clouds_light_night"
            android:indeterminateOnly="true"
            android:maxHeight="400dp"
            android:maxWidth="2000dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/scene_anim_clouds_heavy"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_scene_clouds_heavy"
            android:indeterminateOnly="true"
            android:maxHeight="400dp"
            android:maxWidth="2000dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/scene_anim_clouds_heavy_night"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_scene_clouds_heavy_night"
            android:indeterminateOnly="true"
            android:maxHeight="400dp"
            android:maxWidth="2000dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/scene_anim_fog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_scene_fog"
            android:indeterminateOnly="true"
            android:maxHeight="400dp"
            android:maxWidth="2000dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/scene_anim_rain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_scene_rain"
            android:indeterminateOnly="true"
            android:maxHeight="400dp"
            android:maxWidth="2000dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/scene_anim_snow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_scene_snow"
            android:indeterminateOnly="true"
            android:maxHeight="400dp"
            android:maxWidth="2000dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/scene_anim_bolt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_scene_bolt"
            android:indeterminateOnly="true"
            android:maxHeight="400dp"
            android:maxWidth="2000dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/card_body"
        style="@style/AagCardBody"
        android:background="@drawable/card_bg_material_border"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="5dp"
        android:paddingEnd="14dp"
        android:paddingBottom="5dp">

        <!-- Main row: 72dp. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/weather_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="39dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/weather_icon"
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_weather_cloudy" />

                <TextView
                    android:id="@+id/weather_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.03"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="32sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                android:id="@+id/weather_title"
                android:layout_width="match_parent"
                android:layout_height="19dp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFFFF" />

                    <TextView
                android:id="@+id/weather_detail"
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFC4C6D0"
                android:layout_marginTop="1dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/complications_anchor"
                android:layout_width="match_parent"
                android:layout_height="29dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/forecast"
            android:layout_width="wrap_content"
            android:layout_height="70dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/forecast_col_1"
            android:layout_width="35dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/f1_time"
                android:layout_width="33dp"
                android:layout_height="16dp"
                android:autoSizeMaxTextSize="10sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:background="@drawable/forecast_hour_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:textColor="#FFE2E2E6" />

            <ImageView
                android:id="@+id/f1_icon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/f1_temp"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/forecast_col_2"
            android:layout_width="35dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/f2_time"
                android:layout_width="33dp"
                android:layout_height="16dp"
                android:autoSizeMaxTextSize="10sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:background="@drawable/forecast_hour_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:textColor="#FFE2E2E6" />

            <ImageView
                android:id="@+id/f2_icon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/f2_temp"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/forecast_col_3"
            android:layout_width="35dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/f3_time"
                android:layout_width="33dp"
                android:layout_height="16dp"
                android:autoSizeMaxTextSize="10sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:background="@drawable/forecast_hour_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:textColor="#FFE2E2E6" />

            <ImageView
                android:id="@+id/f3_icon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/f3_temp"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/forecast_col_4"
            android:layout_width="35dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/f4_time"
                android:layout_width="33dp"
                android:layout_height="16dp"
                android:autoSizeMaxTextSize="10sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:background="@drawable/forecast_hour_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:textColor="#FFE2E2E6" />

            <ImageView
                android:id="@+id/f4_icon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/f4_temp"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFFFF" />
        </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/complications"
            android:layout_width="78dp"
            android:layout_height="72dp"
            android:gravity="end|center_vertical"
            android:orientation="vertical"
            android:visibility="gone" />
        </LinearLayout>

        <!-- Summary: what the weather does next and the wind, under the icon; gone when there is nothing to say. -->
        <LinearLayout
            android:id="@+id/weather_summary"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <!-- Centred under the 31dp weather icon: 8 + 14 / 2 = 15 = 31 / 2. -->
            <ImageView
                android:id="@+id/weather_summary_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@null" />

            <!-- Starts under the temperature: 16 + 31 + 6 = 53dp in, so 53 - (16 + 8 + 14) = 15dp after the icon. -->
            <TextView
                android:id="@+id/weather_summary_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="#FFC4C6D0"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hold ring (spec 6.3): traces the card's edge while it is held, until the launcher's menu opens. -->
    <ImageView
        android:id="@+id/hold_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_body_height"
        android:layout_gravity="center_vertical"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:scaleType="fitXY"
        android:src="@drawable/hold_bar_amber_400" />
</FrameLayout>
