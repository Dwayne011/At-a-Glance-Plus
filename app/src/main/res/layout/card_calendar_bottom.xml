<?xml version="1.0" encoding="utf-8"?>
<!-- 8.4 Next calendar event, Layout B: 40dp top row with a 30dp colour bar, 36dp chip strip. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    style="@style/AagCardRoot">

    <LinearLayout
        android:id="@+id/card_body"
        style="@style/AagCardBody"
        android:background="@drawable/card_bg_calendar"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/calendar_bar"
                android:layout_width="5dp"
                android:layout_height="30dp"
                android:contentDescription="@null"
                android:src="@drawable/calendar_bar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/calendar_title"
                    style="@style/AagText.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:freezesText="true"
                    android:lineHeight="18sp"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:textSize="15sp">

                    <requestFocus />
                </TextView>

                <TextView
                    android:id="@+id/calendar_detail"
                    style="@style/AagText.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="#FFCBD5E1" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/complications"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="bottom|start"
            android:orientation="horizontal" />
    </LinearLayout>
</FrameLayout>
