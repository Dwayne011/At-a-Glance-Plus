<?xml version="1.0" encoding="utf-8"?>
<!-- 8.4 Next calendar event, Layout B: 40dp top row with a 30dp colour bar, 36dp chip strip. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    style="@style/AagCardRoot">

    <LinearLayout
        android:id="@+id/card_body"
        style="@style/AagCardBody"
        android:background="@drawable/card_bg_calendar"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/calendar_bar"
                android:layout_width="5dp"
                android:layout_height="30dp"
                android:contentDescription="@null"
                android:src="@drawable/calendar_bar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/calendar_title"
                    style="@style/AagText.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineHeight="17sp"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/calendar_detail"
                    style="@style/AagText.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:lineHeight="14sp"
                    android:textColor="#FFCBD5E1"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/complications"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="bottom|start"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- Hold ring (spec 6.3): traces the card's edge while it is held, until the launcher's menu opens. -->
    <ImageView
        android:id="@+id/hold_bar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:scaleType="fitXY"
        android:src="@drawable/hold_bar_red_400" />
</FrameLayout>
