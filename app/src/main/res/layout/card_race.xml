<?xml version="1.0" encoding="utf-8"?>
<!-- Sports: a followed racing series (Formula 1): the session on now, just finished or next. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    style="@style/AagCardRoot">

    <LinearLayout
        android:id="@+id/card_body"
        style="@style/AagCardBody"
        android:background="@drawable/card_bg_sports"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/race_badge"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/live_badge_bg">

            <ImageView
                android:id="@+id/race_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_nav_flag" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/race_title"
                style="@style/AagText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/race_detail"
                style="@style/AagText.Detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/race_badge_text"
            style="@style/AagText.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/live_eta_bg"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textColor="#FF5EEAD4"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Hold ring (spec 6.3): traces the card's edge while it is held, until the launcher's menu opens. -->
    <ImageView
        android:id="@+id/hold_bar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:scaleType="fitXY"
        android:src="@drawable/hold_bar_red_400" />
</FrameLayout>
