<?xml version="1.0" encoding="utf-8"?>
<!--
    Sports: a followed racing series (Formula 1), Material You sports spec 3.3: the circuit's outline
    in its box, the Grand Prix, the session, and when it is (with a countdown, LIVE, or the result),
    and Next to step through the weekend's sessions. The session on now, just finished or next.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    style="@style/AagCardRoot">

    <LinearLayout
        android:id="@+id/card_body"
        style="@style/AagCardBody"
        android:background="@drawable/f1_surface"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <FrameLayout
            android:id="@+id/race_badge"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/f1_track_box">

            <ImageView
                android:id="@+id/race_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_flag" />

            <ImageView
                android:id="@+id/race_mark_top"
                android:layout_width="14dp"
                android:layout_height="5dp"
                android:layout_gravity="top|end"
                android:layout_margin="5dp"
                android:contentDescription="@null"
                android:src="@drawable/f1_mini_badge" />

            <ImageView
                android:id="@+id/race_mark_bottom"
                android:layout_width="14dp"
                android:layout_height="5dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="5dp"
                android:contentDescription="@null"
                android:src="@drawable/f1_mini_badge" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/race_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/race_session"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="#FFD0E2DC"
                android:textSize="13.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/race_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="#FF8FA8A1"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/race_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/f1_countdown_pill"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:singleLine="true"
                    android:textColor="#FFFFB4AB"
                    android:textSize="10.5sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Next: steps through the weekend's sessions. The touch area is the card's full height,
             beyond the 64 x 36dp button. -->
        <FrameLayout
            android:id="@+id/race_next"
            android:layout_width="68dp"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/race_badge_text"
                android:layout_width="64dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/f1_next_btn"
                android:duplicateParentState="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="#FF4EE2C0"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <!-- Hold ring (spec 6.3): traces the card's edge while it is held, until the launcher's menu opens. -->
    <ImageView
        android:id="@+id/hold_bar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:scaleType="fitXY"
        android:src="@drawable/hold_bar_red_400" />
</FrameLayout>
