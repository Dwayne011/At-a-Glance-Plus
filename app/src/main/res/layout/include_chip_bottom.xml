<?xml version="1.0" encoding="utf-8"?>
<!--
    Material You weather card (weather spec 1.2): a 24dp tonal pill in the strip under the
    temperature, 6dp from the next. Added into a card with RemoteViews.addView, so ids are local to
    each chip.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chip_zone"
    android:layout_width="wrap_content"
    android:layout_height="26dp"
    android:layout_marginEnd="6dp">

    <LinearLayout
        android:id="@+id/chip_pill"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_gravity="start|center_vertical"
        android:duplicateParentState="true"
        android:gravity="center"
        android:minWidth="44dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageView
            android:id="@+id/chip_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/chip_text"
            style="@style/AagText.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:maxWidth="64dp"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
