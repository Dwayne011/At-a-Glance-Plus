<?xml version="1.0" encoding="utf-8"?>
<!--
    One day of forecast as a row: the day, its weather, the chance of rain (10% or more), the low,
    a bar from the low to the high on the rows' shared scale (its start and length set in code),
    and the high. Generated by tools/gen_weather_layouts.py.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    tools:ignore="UseCompoundDrawables">

    <TextView
                android:id="@+id/row_day"
                android:layout_width="40dp"
                android:layout_height="15dp"
                android:autoSizeMaxTextSize="11.5sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFFFF" />

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="2dp"
        android:contentDescription="@null" />

    <TextView
                android:id="@+id/row_rain"
                android:layout_width="40dp"
                android:layout_height="14dp"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:layout_marginStart="6dp" />

    <TextView
                android:id="@+id/row_low"
                android:layout_width="24dp"
                android:layout_height="15dp"
                android:autoSizeMaxTextSize="11.5sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif"
                android:gravity="end|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#99FFFFFF" />

    <FrameLayout
        android:id="@+id/row_track"
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/weather_c_bar">

        <ImageView
            android:id="@+id/row_fill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:src="@drawable/weather_c_bar" />
    </FrameLayout>

    <TextView
                android:id="@+id/row_high"
                android:layout_width="26dp"
                android:layout_height="15dp"
                android:autoSizeMaxTextSize="11.5sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeStepGranularity="0.5sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-medium"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFFFF" />
</LinearLayout>
