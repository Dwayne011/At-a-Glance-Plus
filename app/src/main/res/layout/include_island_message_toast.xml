<?xml version="1.0" encoding="utf-8"?>
<!--
    6.1 Incoming message, shown in place of the first card until it is swiped past, tapped or
    replaced. The launcher draws the swap, so the spec's slide/scale curve cannot be controlled;
    instead the avatar animates: island_fx_enter (pop, ring burst, then pulse) until the card has
    been seen, island_fx_pulse (pulse only) afterwards. Neither is shown on the always-on display,
    which uses the plain island_avatar.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    style="@style/AagCardRoot">

    <FrameLayout
        android:id="@+id/card_body"
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_body_height"
        android:layout_gravity="center_vertical"
        android:background="@drawable/card_bg_island"
        android:clipToOutline="true">

        <!-- Behind the avatar, centred on it: the card is centred vertically, and 16dp padding + 23dp radius - 39dp = 0 across. -->
        <ProgressBar
            android:id="@+id/island_fx_enter"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_gravity="start|center_vertical"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_island_enter"
            android:indeterminateOnly="true"
            android:maxHeight="78dp"
            android:maxWidth="78dp"
            android:minHeight="78dp"
            android:minWidth="78dp" />

        <ProgressBar
            android:id="@+id/island_fx_pulse"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_gravity="start|center_vertical"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/avd_island_pulse"
            android:indeterminateOnly="true"
            android:maxHeight="78dp"
            android:maxWidth="78dp"
            android:minHeight="78dp"
            android:minWidth="78dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="18dp">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp">

                <ImageView
                    android:id="@+id/island_avatar"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:contentDescription="@null"
                    android:src="@drawable/island_avatar_bg" />

                <TextView
                    android:id="@+id/island_initial"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="#FF04130A"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/island_badge_bg">

                    <ImageView
                        android:id="@+id/island_badge_icon"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chat_badge" />
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/island_app"
                        style="@style/AagText.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAllCaps="true"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/island_sender"
                        style="@style/AagText.Badge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/island_time"
                        style="@style/AagText.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif"
                        android:text="· Just now"
                        android:textColor="#FF94A3B8" />

                    <!-- A subtle fading dot in the app's colour: the message is new. -->
                    <ProgressBar
                        android:id="@+id/island_dot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="7dp"
                        android:indeterminate="true"
                        android:indeterminateDrawable="@drawable/avd_island_dot"
                        android:indeterminateOnly="true"
                        android:maxHeight="6dp"
                        android:maxWidth="6dp"
                        android:minHeight="6dp"
                        android:minWidth="6dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/island_message"
                    style="@style/AagText.Detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:lineHeight="17sp"
                    android:maxLines="3"
                    android:textColor="#FFF1F5F9" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/island_reply"
                android:layout_width="66dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Reply">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:background="@drawable/island_reply_bg"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:text="Reply ↵"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
