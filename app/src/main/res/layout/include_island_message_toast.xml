<?xml version="1.0" encoding="utf-8"?>
<!--
    6.1 Incoming message, shown in place of the first card for 4.5 seconds.
    It is pushed as its own card and swapped back afterwards; the launcher draws the swap, so the
    spec's slide/scale entry curve cannot be controlled. The 3dp countdown bar steps every 0.5s.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_root"
    style="@style/AagCardRoot">

    <FrameLayout
        android:id="@+id/card_body"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/card_bg_island"
        android:clipToOutline="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="18dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <ImageView
                    android:id="@+id/island_avatar"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:contentDescription="@null"
                    android:src="@drawable/island_avatar_bg" />

                <TextView
                    android:id="@+id/island_initial"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="#FF04130A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/island_badge_bg">

                    <ImageView
                        android:id="@+id/island_badge_icon"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chat_badge" />
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/island_app"
                        style="@style/AagText.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAllCaps="true"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/island_sender"
                        style="@style/AagText.Badge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/island_time"
                        style="@style/AagText.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif"
                        android:text="· Just now"
                        android:textColor="#FF94A3B8" />

                    <ProgressBar
                        android:id="@+id/island_eq"
                        android:layout_width="21dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="6dp"
                        android:indeterminate="true"
                        android:indeterminateDrawable="@drawable/avd_island_equalizer"
                        android:indeterminateOnly="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/island_message"
                    style="@style/AagText.Detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FFF1F5F9" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/island_reply"
                android:layout_width="64dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Reply">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:background="@drawable/island_reply_bg"
                    android:duplicateParentState="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:text="Reply ↵"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/island_countdown"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="1000"
            android:progress="1000"
            android:progressDrawable="@drawable/island_progress" />
    </FrameLayout>
</FrameLayout>
