<?xml version="1.0" encoding="utf-8"?>
<!--
    Weather hybrid spec, variant 1: one of 2 stacked chips in the 72dp right column (72 x 30dp tap zone, 24dp pill).
    Added into a card with RemoteViews.addView, so ids are local to each chip.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chip_zone"
    android:layout_width="72dp"
    android:layout_height="30dp">

    <LinearLayout
        android:id="@+id/chip_pill"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:duplicateParentState="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/chip_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/chip_text"
            style="@style/AagText.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:maxWidth="56dp"
            android:textColor="#FFE2E2E6"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
