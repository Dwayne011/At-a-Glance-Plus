<?xml version="1.0" encoding="utf-8"?>
<!--
    A chip tile in the two-panel cards, on one grid: line 1 (19dp) the icon and value, with a note
    at the end (beside a bar); line 2 (13dp) a detail or a bar from one labelled end to the other.
    Full size takes half a row; compact (a third, its padding and icon set smaller in code) is used
    only when the chips would not fit otherwise. Generated by tools/gen_weather_layouts.py.
-->
<!-- The zone takes the row's share and the tap; the tile inside carries the background (code changes it). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chip_zone"
    tools:ignore="UselessParent,UseCompoundDrawables,NestedWeights"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1">

    <LinearLayout
        android:id="@+id/chip_pill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/weather_c_tile"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="9dp"
        android:paddingEnd="9dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="19dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/chip_icon"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null" />

            <TextView
                    android:id="@+id/chip_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1" />

            <TextView
                    android:id="@+id/chip_aside"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp"
                    android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/chip_line2"
            android:layout_width="match_parent"
            android:layout_height="13dp"
            android:layout_marginTop="2dp">

            <TextView
                    android:id="@+id/chip_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp"
                    android:layout_gravity="center_vertical" />

            <LinearLayout
                android:id="@+id/chip_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/chip_lo_icon"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@null"
                    android:visibility="gone" />

                <TextView
                        android:id="@+id/chip_lo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp" />

                <FrameLayout
                    android:id="@+id/chip_track"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/weather_c_bar">

                    <ImageView
                        android:id="@+id/chip_fill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:src="@drawable/weather_c_bar" />
                </FrameLayout>

                <TextView
                        android:id="@+id/chip_hi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp" />

                <ImageView
                    android:id="@+id/chip_hi_icon"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginStart="2dp"
                    android:contentDescription="@null"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
